{
  "name": "subq-pr-risk-scanner",
  "version": "1.0.2",
  "private": true,
  "description": "GitHub Action that assesses pull request risk with SubQ Snap decisions, deterministic rules and scanner findings.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "picomatch": "^4.0.7",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@types/picomatch": "^4.0.3",
    "@vitest/coverage-v8": "^5.0.4",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrexhepi/PRison.git"
  },
  "author": "Muharrem Rexhepi",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "eval": "tsx scripts/evaluate.ts",
    "verify:dist": "node scripts/verify-dist.mjs",
    "all": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build && npm run verify:dist"
  }
}
