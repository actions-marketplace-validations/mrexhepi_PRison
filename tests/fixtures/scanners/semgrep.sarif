{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Semgrep OSS",
          "rules": [
            {
              "id": "javascript.lang.security.audit.code-string-concat",
              "shortDescription": { "text": "User input flows into eval" },
              "defaultConfiguration": { "level": "error" },
              "properties": { "tags": ["security"], "security-severity": "8.1" }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "javascript.lang.security.audit.code-string-concat",
          "level": "error",
          "message": { "text": "Detected user input flowing into eval()." },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "src/handler.js" },
                "region": { "startLine": 2, "endLine": 2 }
              }
            }
          ]
        },
        {
          "ruleId": "javascript.lang.security.audit.code-string-concat",
          "level": "error",
          "message": { "text": "Suppressed result." },
          "suppressions": [{ "kind": "inSource" }],
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "src/handler.js" },
                "region": { "startLine": 9 }
              }
            }
          ]
        }
      ]
    }
  ]
}
